// Translated from: mesh/planeclip.c
//
// NOT SUPPORTED (glClipPlane): the original renders a clipped sphere using
// glClipPlane(...) + glEnable(GL_CLIP_PLANE0). pss exposes neither, so the
// clipping cannot be reproduced. The geometry (a wire sphere) is the same as
// 14_wire_sphere.pss but without the cut. See NOT_SUPPORTED.md.


setfov(45);
glTranslate(0, 0, -4);

R = 1.0; segs = 40; rings = 20;
for (lat = 0; lat <= rings; lat = lat + 1) {
    phi = lat * PI / rings - PI/2;
    y = R * sin(phi); rr = R * cos(phi);
    glColor(0.3, 0.8, 1.0);
    glBegin(GL_LINE_STRIP);
    for (lon = 0; lon <= segs; lon = lon + 1) {
        th = lon * 2 * PI / segs;
        glVertex(rr * cos(th), y, rr * sin(th));
    }
    glEnd();
}
