// Translated from: glaux/transform.c
// A wire-frame cube animated by a rotate -> translate -> rotate transform chain.
// Original used auxWireCube (GLU/glaux geometry); pss builds the box edges
// manually. gluPerspective is replaced by setfov().


setfov(45);

glPushMatrix();
glTranslate(0, 0, -5);       // push into view（**必须在两句 rotate 之前**：GL 的矩阵是
                             // 反着作用到顶点上的，放在后面就变成"先平移再绕原点转"，
                             // 立方体会整个转出视野 —— 三档设备都只出黑屏）
glRotate(45.0, 0, 1, 0);     // rot1
glRotate(45.0, 1, 0, 0);     // rot2

hx = 0.5; hy = 0.5; hz = 0.5;
glColor(0.7, 0.7, 0.7);
// bottom + top faces
glBegin(GL_LINE_STRIP);
glVertex(-hx, -hy, -hz); glVertex( hx, -hy, -hz); glVertex( hx,  hy, -hz); glVertex(-hx,  hy, -hz); glVertex(-hx, -hy, -hz);
glEnd();
glBegin(GL_LINE_STRIP);
glVertex(-hx, -hy,  hz); glVertex( hx, -hy,  hz); glVertex( hx,  hy,  hz); glVertex(-hx,  hy,  hz); glVertex(-hx, -hy,  hz);
glEnd();
glBegin(GL_LINES);
glVertex(-hx, -hy, -hz); glVertex(-hx, -hy,  hz);
glVertex( hx, -hy, -hz); glVertex( hx, -hy,  hz);
glVertex( hx,  hy, -hz); glVertex( hx,  hy,  hz);
glVertex(-hx,  hy, -hz); glVertex(-hx,  hy,  hz);
glEnd();
glPopMatrix();
