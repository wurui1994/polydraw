// Translated from: basic/house.c
// A red triangle roof, blue square body, and yellow door, drawn as GL_POLYGON
// primitives. Coordinates rescaled from the original [-0.75..0.5] range into the
// default perspective view (z = -3 to sit in front of the camera).


// roof (red triangle)
glColor(1, 0, 0);
glBegin(GL_POLYGON);
glVertex( 0.0,  0.5, -3);
glVertex(-0.5,  0.0, -3);
glVertex( 0.5,  0.0, -3);
glEnd();

// body (blue quad)
glColor(0, 0, 1);
glBegin(GL_POLYGON);
glVertex(-0.5,  0.0, -3);
glVertex( 0.5,  0.0, -3);
glVertex( 0.5, -0.75, -3);
glVertex(-0.5, -0.75, -3);
glEnd();

// door (yellow quad)
glColor(1, 1, 0);
glBegin(GL_POLYGON);
glVertex( 0.0, -0.25, -3);
glVertex( 0.25, -0.25, -3);
glVertex( 0.25, -0.75, -3);
glVertex( 0.0, -0.75, -3);
glEnd();
