// Translated from: mesh/mesh.c
// A wireframe grid surface z = x*x - y*y (a hyperbolic-paraboloid / saddle),
// drawn as line-loop quads.
//
// The original used glPolygonMode(GL_FRONT_AND_BACK, GL_LINE) together with a
// single GL_QUADS stream, so only the quad *edges* were stroked (no fill). pss
// does not expose glPolygonMode, so each cell is drawn as a closed
// GL_LINE_STRIP — visually identical wireframe. (See NOT_SUPPORTED.md:
// glPolygonMode.)
//
// Other faithful details:
//   - height field fun(x,y) = x*x - y*y  (NOT a sin/cos wave)
//   - domain x,y in [-1, 1], M = N = 30 cells (dx = dy = 2/30)
//   - single cyan color glColor(0,1,1) for the whole mesh
//   - transform: translate z -7, rotate X 45deg, then spin Z ~100deg/s
//     (original spun Z by 10deg every 100ms via a glut timer; pss uses klock())


setfov(45);
glTranslate(0, 0, -7);
glRotate(45.0, 1, 0, 0);
glRotate(klock() * 100.0, 0, 0, 1);   // ~100 deg/sec about Z (was 10 deg/100ms)

glColor(0, 1, 1);

M = 30;
N = 30;
dx = 2.0 / M;
dy = 2.0 / N;
sx0 = -1.0;
sy0 = -1.0;
for (i = 0; i < M; i = i + 1) {
    sx = sx0 + i * dx;
    for (j = 0; j < N; j = j + 1) {
        sy = sy0 + j * dy;
        // four corners of the cell, in the original GL_QUADS vertex order:
        //   (sx,    sy)    (sx+dx, sy)    (sx+dx, sy+dy)    (sx,    sy+dy)
        x0 = sx;       y0 = sy;       z0 = x0*x0 - y0*y0;
        x1 = sx + dx;  y1 = sy;       z1 = x1*x1 - y1*y1;
        x2 = sx + dx;  y2 = sy + dy;  z2 = x2*x2 - y2*y2;
        x3 = sx;       y3 = sy + dy;  z3 = x3*x3 - y3*y3;
        glBegin(GL_LINE_STRIP);
        glVertex(x0, y0, z0);
        glVertex(x1, y1, z1);
        glVertex(x2, y2, z2);
        glVertex(x3, y3, z3);
        glVertex(x0, y0, z0);   // close the loop (GL_LINE_LOOP not implemented)
        glEnd();
    }
}
