static tex[4] = {0.0, 0.35, 0.7, 1.0};
glsettex(4, tex, 2, 2, KGL_FLOAT);
glactivetexture(GL_TEXTURE0);
glbindtexture(4);
glsetshader("pass", "sample");
glquad(1);

@v:pass
varying vec4 t;
void main()
{
  gl_Position = ftransform();
  t = gl_MultiTexCoord0;
}

@f:sample
varying vec4 t;
uniform sampler2D tex0;
void main()
{
  gl_FragColor = texture2D(tex0, t.xy);
}
