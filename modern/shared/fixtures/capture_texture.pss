glcapture(8, 4, 4, KGL_FLOAT);
glsetshader("pass", "solid");
glColor(0.25, 0.0, 0.0);
glquad(1);
glcaptureend(8);

glactivetexture(GL_TEXTURE0);
glbindtexture(8);
glsetshader("pass", "sample");
glquad(1);

@v:pass
varying vec4 t;
void main()
{
  gl_Position = ftransform();
  t = gl_MultiTexCoord0;
}

@f:solid
void main()
{
  gl_FragColor = vec4(0.25, 0.0, 0.0, 1.0);
}

@f:sample
varying vec4 t;
uniform sampler2D tex0;
void main()
{
  gl_FragColor = texture2D(tex0, t.xy);
}
