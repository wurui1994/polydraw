glsettex(3, "synthetic.png");
glactivetexture(GL_TEXTURE0 + 0);
glbindtexture(3);
glsetshader("pass", "sample");
glquad(1);

@v:pass
varying vec4 t;
void main()
{
  gl_Position = ftransform();
  t = gl_MultiTexCoord0;
}

@f:sample
varying vec4 t;
uniform sampler2D tex0;
void main()
{
  gl_FragColor = texture2D(tex0, t.xy);
}
